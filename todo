## FSTRINGS -> Convertir cualquier variable a texto dentro de una cadena de texto
#Aunque las variabes X y Y no son str se convierten a str cuando estan metidas en {} y al inicio de las comillas dobles hay una f (f"")

x= True
y= 5
Saludox = f"hola {x} ¿como estas?"       
Saludoy = f"hola {y} ¿como estas?"  
print(Saludox)
print(Saludoy)
       


   ### DATOS COMPUESTOS ###
   
#Listas
lista = []
lista1=["Andrés","Aguilera",True,1.69]   
lista1[0]       #Elemento en la posicion cero es el primero, osea "Andrés"
lista1[2]       #Elemento en la posicion 2 es True
lista1[3]=2     #Ahora el ultimo elemento de la lista es 2 no 1.69



#Tuplas -> Como una lista pero no se puede modificar
tupla = ()
tupla1 = (2, 5,"Que loco",False)
tubla2= "Andres", "Aguilera"   
tupla3 = tuple(["Andres", "Aguilera"])



#Set/Conjunto -> Como una lista pero los elementos no están ordenados por posicion. NO PERMITE VALORES DUPLICADOS.
conjunto={}
conjunto1={2,5,True,"hola"}
conjunto1={"redefinir"}       #Se puede redefinir el conjunto por completo pero no cambiar un solo elemento
conjunto2 = set(["xd",1,2,"ola"])

conjuntocongelado=frozenset([1,2,3])   #Frozenset es un conjunto inmutable
super_conjunto = {conjuntocongelado,25}


#Diccionario -> Como una lista pero le podemos poner nombre al indice
diccionario = {
