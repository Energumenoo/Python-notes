    }

diccionario2 = dict(nombre ="andres", apellido="Aguilera")

diccionario["nombre indice"] #Es lo mismo que diccionario_usado_como_lista[0]
diccionario_usado_como_lista[0]



   ### OPERADORES LÓGICOS ###

