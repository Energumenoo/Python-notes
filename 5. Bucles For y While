#iterar un diccionario

diccionario = {
    "nombre": "Andrés",
    "apellido": "Aguilera",
    "nacionalidad": "Colombiano"
    }   

for i in diccionario:         #Devuelve solo el indice
    print(i)

for i in diccionario.items():         #Devuelve una tupla para cada clave del indice con su valor
    print(i)
    
for i in diccionario.items():         #Asi podemos acceder al valor y al indice
    clave = i[0]
    valor = i[1]
    print("La clave es ", clave," y el valor es ", valor)
   
   
   

