# Usar CONTINUE en un bucle para excluir un valor de lo que estamos iterando

for i in range(10):     #Va a imprimir todos los valores menos el 6
    if i == 6 :
        continue
    print(i)

for i in range(10):     #Va a imprimir todos los valores menos el 6
    print("x")          #Va a imprimir x 10 veces porque está antes de la condicion de obviar al 6  
    if i == 6 :
        continue
    print("terminado")   #Va a imprimir terminado 9 veces porque está despues de la condicion de obviar al 6  
    print(i)             #Va a imprimir i 9 veces porque está despues de la condicion de obviar al 6 

#Usar break para terminar el bucle si se cumple una condicion

for i in range(10):          #Va a imprimir hasta que encuentre el 6
    print(i)
    if i == 6:
        break
else: print("terminado")     #No ejecuta el else porque despues del break no se ejecuta nada. Solo se ejecutaria else si no hubiera un 6
                            #Si el else tuviera la misma indentación que el if iprimiria terminado cada vez que imprime un numero


for i in range(10):          #Imprime hasta el 5, porque apenas encuentra el 6 se rompe               
    if i ==6:
        break
    print(i)

